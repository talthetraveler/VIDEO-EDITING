@@ -0,0 +1,51 @@
+"""The three things IN2OUT uses from mmcv, without mmcv.
+
+mmcv has no wheel for Python 3.12 on Windows and building it needs a C++ compiler. torchvision's
+deform_conv2d(mask=...) is the same operation (modulated deformable convolution, DCNv2); its groups
+are worked out from the tensor shapes, so deform_groups=16 / groups=1 needs no extra arguments.
+"""
+import torch, torch.nn as nn
+from torchvision.ops import deform_conv2d
+
+
+def constant_init(module, val, bias=0):
+    nn.init.constant_(module.weight, val)
+    if getattr(module, "bias", None) is not None:
+        nn.init.constant_(module.bias, bias)
+
+
+class ConvModule(nn.Module):
+    """Conv + activation with mmcv's sub-module names, so checkpoint keys match."""
+    def __init__(self, in_channels, out_channels, kernel_size, stride=1, padding=0, norm_cfg=None, act_cfg=None):
+        super().__init__()
+        assert norm_cfg is None and act_cfg in (None, dict(type="ReLU"))
+        self.conv = nn.Conv2d(in_channels, out_channels, kernel_size, stride, padding, bias=True)
+        self.activate = nn.ReLU(inplace=True) if act_cfg else None
+    def forward(self, x):
+        x = self.conv(x)
+        return self.activate(x) if self.activate else x
+
+
+def load_checkpoint(model, url, strict=True):
+    """SPyNet's own pretrained download. Skipped: the E2FGVI checkpoint carries those weights
+    (update_spynet.*), and infer_example.py loads it with strict=True, so a gap would raise."""
+    print("mmcv_shim: skipping", url)
+
+
+class ModulatedDeformConv2d(nn.Module):
+    def __init__(self, in_channels, out_channels, kernel_size, stride=1, padding=0, dilation=1,
+                 groups=1, deform_groups=1, bias=True):
+        super().__init__()
+        p = lambda v: (v, v) if isinstance(v, int) else tuple(v)
+        self.in_channels, self.out_channels = in_channels, out_channels
+        self.kernel_size, self.stride, self.padding, self.dilation = p(kernel_size), p(stride), p(padding), p(dilation)
+        self.groups, self.deform_groups = groups, deform_groups
+        self.weight = nn.Parameter(torch.Tensor(out_channels, in_channels // groups, *self.kernel_size))
+        self.bias = nn.Parameter(torch.Tensor(out_channels)) if bias else None
+        nn.init.kaiming_uniform_(self.weight, a=5 ** 0.5)
+        if self.bias is not None:
+            nn.init.zeros_(self.bias)
+
+
+def modulated_deform_conv2d(x, offset, mask, weight, bias, stride, padding, dilation, groups, deform_groups):
+    return deform_conv2d(x, offset, weight, bias, stride, padding, dilation, mask)
