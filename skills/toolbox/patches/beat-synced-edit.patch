+def split_long_scenes(scenes, max_scene):
+    """Split scenes longer than max_scene into equal pieces. A 360 or POV clip
+    is one long take, so scene detection alone finds one scene and the edit
+    gets one cut. Pieces are sub-clips of that take."""
+    if not max_scene or max_scene <= 0:
+        return scenes
+    out = []
+    for s in scenes:
+        n = int(s['duration'] // max_scene)
+        if n < 2:
+            out.append(s)
+            continue
+        step = s['duration'] / n
+        for k in range(n):
+            a = s['start'] + k * step
+            out.append({"start": round(a, 3), "end": round(a + step, 3), "duration": round(step, 3)})
+    return out
+
