+def extract_clip(video_path, start, frames, output_path, temp_dir, fps=30, size=None):
+    """Extract exactly `frames` frames from video using FFmpeg.
+
+    Every clip gets the same size, frame rate and limited-range BT.709, so they
+    join without a re-encode and the cuts stay on the frame they were placed on.
+    tpad holds the last frame if the source ends first.
+    """
+    vf = []
+    if size:
+        w, h = size.lower().split('x')
+        vf += [f"scale={w}:{h}:force_original_aspect_ratio=increase:out_color_matrix=bt709:out_range=tv",
+               f"crop={w}:{h}"]
+    else:
+        vf.append("scale=trunc(iw/2)*2:trunc(ih/2)*2:out_color_matrix=bt709:out_range=tv")
+    vf += ["setsar=1", f"fps={fps}", "tpad=stop_mode=clone:stop_duration=60", "format=yuv420p"]
 
