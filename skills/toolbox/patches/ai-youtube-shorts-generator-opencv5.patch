+def _face_detector(cv2, src_w: int, src_h: int):
+    """Return frame -> list of (x, y, w, h) faces, for whichever detector this OpenCV has."""
+    if hasattr(cv2, "CascadeClassifier"):
+        cascade = cv2.CascadeClassifier(cv2.data.haarcascades + "haarcascade_frontalface_default.xml")
+
+        def haar(frame):
+            gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
+            return list(cascade.detectMultiScale(gray, scaleFactor=1.1, minNeighbors=5, minSize=(40, 40)))
+        return haar
+
+    model = os.path.join(os.path.dirname(__file__), "..", "..", "models", "face_detection_yunet_2023mar.onnx")
+    if hasattr(cv2, "FaceDetectorYN_create") and os.path.exists(model):
+        yunet = cv2.FaceDetectorYN_create(model, "", (src_w, src_h), 0.6)
+
+        def yn(frame):
+            _, found = yunet.detect(frame)
+            return [] if found is None else [tuple(int(v) for v in f[:4]) for f in found]
+        return yn
+
+    return lambda frame: []
+
