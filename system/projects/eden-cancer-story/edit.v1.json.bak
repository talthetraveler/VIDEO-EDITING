      0,
      16.9,
      0.5,
      "OPEN on Tal to camera: 'I came to a hospital today and I met Eden. Eden has cancer and she's not giving up. And I came with a bunch of people who are singing to her - every single week.'"
    ],
    [
      "6c7dc882-105c-4f7d-8e52-7280f1f68e97",
      6.8,
      13.4,
      0.5,
      "the volunteers: 'We're playing in the hospital. We're going to people that are sick to make them happy before Shabbat.'"
    ],
    [
      "6c7dc882-105c-4f7d-8e52-7280f1f68e97",
      22.9,
      31.4,
      0.5,
      "'The rabbi said it's a good thing to do - to make people happy is the best thing you can do for a person.'"
    ],
    [
      "06315624-7c72-4016-918e-6e87b875df95",
      3.3,
      12.9,
      0.5,
      "'We're going to play for a cancer patient. Each week we don't forget to visit her. She loves it.'"
    ],
    [
