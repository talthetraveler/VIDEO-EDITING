      13.6,
      31.5,
      0.5,
      "HER STORY (answers only, no questions): 'I'm Eden, 30, fighting leukemia for a year. I lost my mother a year ago.'"
    ],
    [
      "11daa6c3-3ea6-462e-a814-38184327e7e2",
      33.9,
      46.5,
      0.5,
      "'She passed away from cancer. 17 years.'"
    ],
    [
      "11daa6c3-3ea6-462e-a814-38184327e7e2",
      73.8,
      83.2,
      0.5,
      "THE TURN: 'Because I need to be strong - for everyone, for myself, for my family.'"
    ],
    [
