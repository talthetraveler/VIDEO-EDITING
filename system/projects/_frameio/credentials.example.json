{
  "_comment": "Copy to credentials.json and fill in. Frame.io V4 = Adobe IMS OAuth only; there is no plain API key.",

  "_option_A_server_to_server": {
    "mode": "s2s",
    "client_id": "<Adobe Developer Console Client ID (32 hex)>",
    "client_secret": "<Client Secret>",
    "scope": "openid,AdobeID,additional_info.roles"
  },

  "_option_B_paste_a_token": {
    "mode": "token",
    "access_token": "<short-lived IMS access token, for a quick test>"
  },

  "_option_C_refreshable_user_oauth": {
    "mode": "oauth",
    "client_id": "<Client ID>",
    "client_secret": "<Client Secret>",
    "refresh_token": "<refresh token from the authorize flow>"
  }
}
