#!/usr/bin/env node
// IS THE SPEAKER ON SCREEN FOR THIS BEAT?
//
//   node scripts/check-beats.mjs <slug> [--fix]
//
// Tal, on the delivered set and again on the rebuild: beats that caption
// dialogue over a shot with nobody in it — an empty street captioned "HELLO
// BROTHER, I GOT", a wheelbarrow captioned "FOR YOU", crates of lemons
// captioned "CAN YOU GIVE ME", a bicycle part captioned "WHO DO YOU MISS".
//
// WHY THE EARLIER CHECK MISSED THESE. scripts/scan-empty.py asks "is a person
// visible", and its HOG body detector answers YES to Tal's own forearm in a
// POV shot. It passed giving-water 12/12 on a film I could see was broken.
// "Somebody's elbow is in frame" is not "the speaker is on screen".
//
// So this asks a stricter question: is there a FACE — frontal or profile —
// for most of the beat? A body-only or no detection means the beat is picture
// of something, not of someone.
//
// --fix searches the same clip either side of the beat for a window of the
// same length that DOES hold a face, and prints the suggested in/out. It never
// edits edit.json: which beat may move is an editorial call, because some of
// these shots are deliberate (hands giving water, the flowers changing hands)
// and some are dead air. It hands you the measurement; you choose.
import { readFileSync, existsSync } from "node:fs";
import { join } from "node:path";
import { locate } from "./lib/framing.mjs";

const ROOT = "C:/Users/taldo/Downloads/videos to edit";
const PROXY = join(ROOT, "projects/_frameio/cache/proxies");
const HQDIR = join(ROOT, "projects/_frameio/cache/hq");
const LOCAL = existsSync(join(ROOT, "projects/_frameio/cache/local-sources.json"))
  ? JSON.parse(readFileSync(join(ROOT, "projects/_frameio/cache/local-sources.json"), "utf8"))
  : {};

const slug = process.argv[2];
const FIX = process.argv.includes("--fix");
if (!slug) { console.error("usage: node scripts/check-beats.mjs <slug> [--fix]"); process.exit(1); }

const cfg = JSON.parse(readFileSync(join(ROOT, "projects", slug, "edit.json"), "utf8"));

/** Same source resolution the builder uses. */
function sourceOf(id) {
  if (LOCAL[id]?.path && existsSync(LOCAL[id].path)) return { path: LOCAL[id].path, offset: 0 };
  const hq = join(HQDIR, `${id}.mp4`);
  if (existsSync(hq)) {
    for (const f of ["", ""]) {}
    // find this clip's span offset in whichever manifest holds it
    let offset = 0;
    try {
      const { readdirSync } = require("node:fs");
    } catch {}
    return { path: hq, offset: null };      // offset resolved by caller if needed
  }
  const px = join(PROXY, `${id}.mp4`);
  return existsSync(px) ? { path: px, offset: 0 } : null;
}

console.log(`\n${slug} — ${cfg.beats.length} beats\n`);
const bad = [];
for (let i = 0; i < cfg.beats.length; i++) {
  const [id, ss, to, , why, rot] = cfg.beats[i];
  if (id === "CARD") { console.log(`  ${String(i).padStart(2)}  CARD`); continue; }
  const src = sourceOf(id);
  if (!src) { console.log(`  ${String(i).padStart(2)}  no source for ${String(id).slice(0, 8)}`); continue; }
  const dur = to - ss;
  const box = locate(src.path, ss, to, rot ?? 0, Math.max(5, Math.min(10, Math.round(dur))));
  const kind = box?.found ? box.by : "none";
  const conf = box?.found ? box.found / (box.of || 1) : 0;
  const okFace = (kind === "face" || kind === "profile") && conf >= 0.4;
  const mark = okFace ? "ok  " : "!!  ";
  if (!okFace) bad.push(i);
  console.log(`${mark}${String(i).padStart(2)}  ${String(id).slice(0, 8)} ${ss.toFixed(1)}-${to.toFixed(1)} (${dur.toFixed(1)}s)  ` +
    `${kind} ${(conf * 100).toFixed(0)}%   ${String(why ?? "").slice(0, 58)}`);

  if (!okFace && FIX) {
    // look either side for a same-length window that holds a face
    let best = null;
    for (const shift of [-12, -9, -6, -4, -2, 2, 4, 6, 9, 12]) {
      const a = ss + shift, b = to + shift;
      if (a < 0) continue;
      const t = locate(src.path, a, b, rot ?? 0, 5);
      if (!t?.found) continue;
      if (t.by !== "face" && t.by !== "profile") continue;
      const c = t.found / (t.of || 1);
      if (c < 0.6) continue;
      if (!best || Math.abs(shift) < Math.abs(best.shift)) best = { shift, c, by: t.by };
    }
    if (best) console.log(`        -> try ${(ss + best.shift).toFixed(1)}-${(to + best.shift).toFixed(1)} ` +
      `(${best.shift > 0 ? "+" : ""}${best.shift}s)  ${best.by} ${(best.c * 100).toFixed(0)}%`);
    else console.log(`        -> nothing nearby holds a face; this beat needs different footage`);
  }
}
console.log(`\n${bad.length} of ${cfg.beats.length} beats have no face on screen: [${bad.join(", ")}]`);
