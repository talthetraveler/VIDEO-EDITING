# Copy to system/.env and fill in. Never commit the real .env (it is git-ignored).

# Transcription (Groq whisper-large-v3-turbo) - used by transcribe-local,
# frameio-transcribe, study-reference, reference-shots. https://console.groq.com/keys
GROQ_API_KEY=

# Hugging Face - speaker diarization / gated models (WhisperX, pyannote).
HF_TOKEN=
HUGGINGFACE_TOKEN=

# Frame.io is NOT configured here: see system/projects/_frameio/credentials.example.json
